# Caddyfile — reverse proxy and landing hub for the Nutrition API.
#
# Caddy fronts the uvicorn backend (the systemd service on 127.0.0.1:8080):
# it terminates TLS with an automatic certificate, serves a static landing page
# at the root, proxies the application and API paths to the backend, and answers
# its own /caddy-health so the status page can see the proxy independently.
#
#   Landing hub (deploy/site/index.html)  /
#   Status dashboard                      /status
#   Lookup tester                         /ui/
#   GPC browser                           /gpc
#   Swagger / ReDoc / OpenAPI             /docs, /redoc, /openapi.json
#   JSON API                              /api/*
#
# The routing lives in caddy/site.caddy and is imported below, so this example,
# the local-test block, and the installed /etc/caddy/Caddyfile all share it.

import caddy/site.caddy

# ── Production: replace with your domain, then Caddy handles HTTPS ─────
nutrition.example.org {
	import nutrition_api

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/nutrition-api.log
	}
}

# ── Local testing: no domain, no TLS ──────────────────────────────────
# caddy run --config deploy/Caddyfile   →   http://localhost:8081/
:8081 {
	import nutrition_api
}
