[Unit]
Description=Nutrition API (FastAPI/uvicorn)
Documentation=https://github.com/mcgarrah/nutrition_api
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcgarrah
Group=mcgarrah
WorkingDirectory=/opt/nutrition_api

# Supplies FDC_API_KEY. Keep this file out of git (.env is gitignored).
EnvironmentFile=/opt/nutrition_api/.env

ExecStart=/opt/nutrition_api/.venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 --port 8080 --workers 2

Restart=on-failure
RestartSec=5s

# Startup checks GS1 for a newer GPC release; give it room without hanging boot
TimeoutStartSec=180s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nutrition-api

# The service only needs to read its own tree and write the GPC cache
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/nutrition_api/data

# Sized for a 12 GB RAM / 4 vCPU host that also runs Caddy, Docker, and other
# services -- these bound a runaway (a memory leak, a pathological response)
# without touching normal operation, which sits around 120 MB RSS. MemoryHigh
# is a soft throttle point reached well before the hard MemoryMax kill, so the
# service degrades under pressure rather than being OOM-killed outright.
# CPUQuota=200% is 2 of the 4 cores, matching --workers 2 above, leaving the
# other 2 for everything else on the box.
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
